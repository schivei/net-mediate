<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\..\pack.props" />
	<PropertyGroup>
		<Title>NetMediate.Core</Title>
		<Description>Core contracts for NetMediate, a high-performance, convention-based mediator library for .NET.</Description>
		<PackageTags>Mediator;NetMediate;Core</PackageTags>
		<TargetFramework>netstandard2.0</TargetFramework>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsAsErrors />
		<WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
		<GenerateDocumentationFileInReleaseBuild>true</GenerateDocumentationFileInReleaseBuild>
		<NoWarn>$(NoWarn);CA1873</NoWarn>
		<RootNamespace>NetMediate</RootNamespace>
	</PropertyGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="NetMediate.Tests" />
		<InternalsVisibleTo Include="NetMediate.Compat" />
		<InternalsVisibleTo Include="NetMediate.Moq" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
		<InternalsVisibleTo Include="SharedParity.NetMediate.Tests" />
		<InternalsVisibleTo Include="SharedParity.MediatRCompat.Tests" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\..\assets\logo.png" Pack="true" PackagePath="\" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="GenDI" Version="2026.5.25.1004" />
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.*" />
		<PackageReference Include="System.Collections.Immutable" Version="10.0.8" />
	</ItemGroup>

</Project>
