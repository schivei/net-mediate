<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\..\pack.props" />
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<AssemblyName>NetMediate.SourceGeneration</AssemblyName>
		<Title>NetMediate.SourceGeneration</Title>
		<Description>Source generator package for NetMediate. Installs the generator directly and wires NetMediate runtime + GenDI.SourceGenerator through buildTransitive.</Description>
		<PackageTags>Mediator;NetMediate;SourceGenerator;AOT;Startup</PackageTags>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<NoWarn>$(NoWarn);RS2008;NU5128</NoWarn>
		<!--
		  DevelopmentDependency is intentionally NOT set here. Setting it causes NuGet pack to strip
		  ALL package dependencies from the generated nuspec, which would prevent NetMediate and
		  GenDI.SourceGenerator from being restored by consuming projects. Consumers that want to
		  treat this package as dev-only should add PrivateAssets="all" to their PackageReference
		  (see installation docs), which is also what the buildTransitive props enforces automatically.
		-->
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\..\assets\logo.png" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="NetMediateGeneratedDI.template" />
		<EmbeddedResource Include="NetMediateTypedExtensions.template" />
		<None Include="buildTransitive\NetMediate.SourceGeneration.props" Pack="true" PackagePath="buildTransitive" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.*" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.*" PrivateAssets="all" />

		<!--
		  Declare NetMediate and GenDI.SourceGenerator as nuspec dependencies so NuGet includes them
		  in project.assets.json during dotnet restore. Without these entries the packages are only
		  injected via buildTransitive MSBuild props at build time — too late for pipelines that run
		  dotnet restore and dotnet build as separate steps (e.g. Azure DevOps no-restore builds).

		  ExcludeAssets="compile" prevents the netstandard2.0 generator project from trying to use
		  the net10.0 compile-time DLLs directly (NU1701/NU1202 are suppressed per-reference below).
		-->
		<PackageReference Include="NetMediate" Version="$(VersionYear).*">
			<ExcludeAssets>compile; runtime</ExcludeAssets>
			<NoWarn>NU1701;NU1202</NoWarn>
		</PackageReference>
		<PackageReference Include="GenDI.SourceGenerator" Version="26.*">
			<ExcludeAssets>compile</ExcludeAssets>
			<NoWarn>NU1701;NU1202</NoWarn>
		</PackageReference>

		<None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="true" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="buildTransitive\" />
	</ItemGroup>
</Project>
