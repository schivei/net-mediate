<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\pack.props" />
  <PropertyGroup>
    <!-- XML Documentation Generation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <!-- Enforce XML Documentation -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <!-- Make missing XML documentation a warning that gets promoted to error in CI -->
    <GenerateDocumentationFileInReleaseBuild>true</GenerateDocumentationFileInReleaseBuild>
    <NoWarn>$(NoWarn);CA1873</NoWarn>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>
  <!-- Enable XML documentation warnings as errors only in Release mode for stricter CI enforcement -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <WarningsNotAsErrors />
    <WarningsAsErrors>CS1591</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NetMediate.Tests" />
    <InternalsVisibleTo Include="NetMediate.Compat" />
    <InternalsVisibleTo Include="NetMediate.Moq" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    <InternalsVisibleTo Include="SharedParity.NetMediate.Tests" />
    <InternalsVisibleTo Include="SharedParity.MediatRCompat.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\assets\logo.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <!--
      buildTransitive: ensures both source generators propagate to transitive consumers
      (projects that depend on a library that depends on NetMediate). Without this, the
      generators would only run for projects that directly reference the NetMediate package.
    -->
    <None Include="buildTransitive\NetMediate.props" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference
      Include="..\NetMediate.SourceGeneration\NetMediate.SourceGeneration.csproj"
      ReferenceOutputAssembly="false"
      OutputItemType="Analyzer"
      PrivateAssets="all"
    />
    <None
      Include="$(MSBuildThisFileDirectory)..\NetMediate.SourceGeneration\bin\$(Configuration)\netstandard2.0\NetMediate.SourceGeneration.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
      Condition="Exists('$(MSBuildThisFileDirectory)..\NetMediate.SourceGeneration\bin\$(Configuration)\netstandard2.0\NetMediate.SourceGeneration.dll')"
    />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageReference
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="10.*"
    />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <!--
      GenDI.SourceGenerator is bundled directly in our analyzers/dotnet/cs/ folder above.
      We still need the PackageReference here (with PrivateAssets="all") so the generator
      runs during NetMediate's own build and the $(PkgGenDI_SourceGenerator) path property
      is generated for inner-build use. The generator emits [Injectable], [ServiceInjection]
      and related attribute types at compile time — no GenDI runtime library is required.
    -->
    <PackageReference Include="GenDI.SourceGenerator" Version="26.*" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.*" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Bundle the GenDI source generator inside our package so consumers get GenDI's
      compile-time DI generation ([Injectable], [ServiceInjection], etc.) for free when
      they install NetMediate, without a separate `dotnet add package GenDI.SourceGenerator`.
    -->
    <_GenDIAnalyzerDll Include="$(NuGetPackageRoot)gendi.sourcegenerator/*/analyzers/dotnet/cs/GenDI.SourceGenerator.dll" />
    <None Include="@(_GenDIAnalyzerDll)" Pack="true" PackagePath="analyzers/dotnet/cs/%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>
</Project>
