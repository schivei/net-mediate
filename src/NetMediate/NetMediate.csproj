<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\pack.props" />
  <PropertyGroup>
    <!-- XML Documentation Generation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <!-- Enforce XML Documentation -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <!-- Make missing XML documentation a warning that gets promoted to error in CI -->
    <GenerateDocumentationFileInReleaseBuild>true</GenerateDocumentationFileInReleaseBuild>
    <NoWarn>$(NoWarn);CA1873</NoWarn>
  </PropertyGroup>
  <!-- Enable XML documentation warnings as errors only in Release mode for stricter CI enforcement -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <WarningsNotAsErrors />
    <WarningsAsErrors>CS1591</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NetMediate.Tests" />
    <InternalsVisibleTo Include="NetMediate.Compat" />
    <InternalsVisibleTo Include="NetMediate.Moq" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    <InternalsVisibleTo Include="SharedParity.NetMediate.Tests" />
    <InternalsVisibleTo Include="SharedParity.MediatRCompat.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\assets\logo.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
  </ItemGroup>
  <PropertyGroup Condition="Exists('$(ProjectAssetsFile)')">
    <_GenDIProjectAssetsFile>$(ProjectAssetsFile)</_GenDIProjectAssetsFile>
    <_GenDIResolvedVersionPattern>gendi\.sourcegenerator/([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)</_GenDIResolvedVersionPattern>
    <_GenDIProjectAssetsContent>$([System.IO.File]::ReadAllText('$(_GenDIProjectAssetsFile)'))</_GenDIProjectAssetsContent>
    <_GenDISourceGeneratorResolvedVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_GenDIProjectAssetsContent)', '$(_GenDIResolvedVersionPattern)').Groups[1].Value)</_GenDISourceGeneratorResolvedVersion>
    <_GenDIAnalyzerResolvedPath>$(NuGetPackageRoot)gendi.sourcegenerator/$(_GenDISourceGeneratorResolvedVersion)/analyzers/dotnet/cs/GenDI.SourceGenerator.dll</_GenDIAnalyzerResolvedPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NetMediate.Core\NetMediate.Core.csproj" />
  </ItemGroup>
  <Target Name="ValidateGenDIAnalyzerVersionResolution" BeforeTargets="GenerateNuspec" Condition="'$(_GenDISourceGeneratorResolvedVersion)' == ''">
    <Warning Text="Could not resolve GenDI.SourceGenerator version from $(ProjectAssetsFile). The bundled GenDI analyzer will not be packed. Run restore and verify GenDI.SourceGenerator restore succeeded." />
  </Target>
</Project>
